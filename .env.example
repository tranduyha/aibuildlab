# ============================================================
# AIBUILDLAB - Environment Variables Example
# File này được phép commit lên GitHub.
# KHÔNG điền key thật vào file này.
# Copy file này thành `.env.local` rồi điền key thật ở máy local.
# ============================================================

# ------------------------------------------------------------
# Site config
# ------------------------------------------------------------
NEXT_PUBLIC_SITE_NAME=AI Build Lab
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_DESCRIPTION=Find the right hardware for local AI, LLMs, Stable Diffusion, and AI workstations.

# Khi deploy production, đổi thành domain thật:
# NEXT_PUBLIC_SITE_URL=https://aibuildlab.com


# ------------------------------------------------------------
# Image source APIs - stock/illustration images
# Dùng cho hero image, guide image, workstation, server, coding desk...
# ------------------------------------------------------------

# Pexels API
# Đăng ký: https://www.pexels.com/api/
PEXELS_API_KEY=

# Unsplash API
# Đăng ký: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=

# Pixabay API - optional
# Đăng ký: https://pixabay.com/api/docs/
PIXABAY_API_KEY=


# ------------------------------------------------------------
# Open-license images
# Wikimedia Commons không bắt buộc API key.
# Dùng để lấy ảnh có license rõ: CC BY, CC BY-SA, Public Domain...
# ------------------------------------------------------------
WIKIMEDIA_COMMONS_API_URL=https://commons.wikimedia.org/w/api.php
WIKIMEDIA_USER_AGENT=aibuildlab/1.0 (contact: your-email@example.com)


# ------------------------------------------------------------
# Product / affiliate image APIs
# Dùng cho ảnh sản phẩm GPU/CPU/mini PC nếu có quyền từ affiliate/API.
# Không scrape ảnh sản phẩm từ Google Images.
# ------------------------------------------------------------

# eBay Browse API
# Đăng ký: https://developer.ebay.com/
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ENV=sandbox
# EBAY_ENV=production

# Amazon Product Advertising API
# Chỉ dùng sau khi có Amazon Associates + PA API access.
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
AMAZON_PAAPI_PARTNER_TAG=
AMAZON_PAAPI_HOST=webservices.amazon.com
AMAZON_PAAPI_REGION=us-east-1
AMAZON_PAAPI_MARKETPLACE=www.amazon.com


# ------------------------------------------------------------
# Optional image storage/CDN
# Giai đoạn đầu có thể chưa cần. Ảnh có thể lưu trong public/images.
# Sau này nếu ảnh nhiều, dùng Cloudflare R2.
# ------------------------------------------------------------

# Cloudflare R2 - optional
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_PUBLIC_URL=


# ------------------------------------------------------------
# Image fetch settings
# Dùng cho script scripts/fetch-images.ts nếu có.
# ------------------------------------------------------------
IMAGE_DOWNLOAD_DIR=public/images
IMAGE_MANIFEST_PATH=data/images/image-manifest.json
IMAGE_MAX_WIDTH=1600
IMAGE_QUALITY=80

# Cho phép script tải ảnh về local.
# Đặt false nếu muốn chỉ preview kết quả search mà không download.
IMAGE_FETCH_ENABLE_DOWNLOAD=true

# Nguồn ưu tiên khi Codex/script tìm ảnh.
# Giá trị gợi ý: pexels,unsplash,wikimedia,ebay
IMAGE_SOURCE_PRIORITY=pexels,unsplash,wikimedia,ebay


# ------------------------------------------------------------
# Safety rules
# Các biến này dùng để nhắc script không dùng nguồn không hợp lệ.
# ------------------------------------------------------------
ALLOW_GOOGLE_IMAGES_DIRECT_DOWNLOAD=false
REQUIRE_IMAGE_LICENSE_METADATA=true
REQUIRE_IMAGE_ALT_TEXT=true
